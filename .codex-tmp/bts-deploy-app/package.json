{
  "name": "ebay-order-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:password": "powershell -ExecutionPolicy Bypass -File scripts/set-admin-password.ps1",
    "products:import": "tsx scripts/import-products.ts",
    "products:image-signatures": "tsx scripts/build-product-image-signatures.ts",
    "products:image-fingerprints": "tsx scripts/build_image_fingerprints.ts",
    "pocamarket:connect": "node scripts/pocamarket-phone-connect.mjs",
    "pocamarket:sync": "tsx scripts/sync-pocamarket-api.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@huggingface/transformers": "^4.2.0",
    "@prisma/client": "^6.19.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "fast-xml-parser": "^5.11.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
