model PricingReview {
  id                    String    @id @default(cuid())
  status                String    @default("DRAFT")
  domesticShippingKrw   Decimal   @map("domestic_shipping_krw") @db.Decimal(12, 2)
  buyingAgencyFeeKrw    Decimal   @map("buying_agency_fee_krw") @db.Decimal(12, 2)
  exchangeRateKrwPerUsd Decimal   @map("exchange_rate_krw_per_usd") @db.Decimal(12, 4)
  targetMarginRate      Decimal   @map("target_margin_rate") @db.Decimal(9, 6)
  ebayFeeRate           Decimal   @map("ebay_fee_rate") @db.Decimal(9, 6)
  advertisingRate       Decimal   @map("advertising_rate") @db.Decimal(9, 6)
  /** 계산 당시 쓴 수수료 설정. 나중에 설정이 바뀌어도 이 검토가 무엇으로 계산됐는지 남는다. */
  internationalFeeRate  Decimal   @default(0) @map("international_fee_rate") @db.Decimal(9, 6)
  perOrderFeeUsd        Decimal   @default(0) @map("per_order_fee_usd") @db.Decimal(12, 2)
  buyerShippingUsd      Decimal   @default(0) @map("buyer_shipping_usd") @db.Decimal(12, 2)
  salesTaxUpliftRate    Decimal   @default(0) @map("sales_tax_uplift_rate") @db.Decimal(9, 6)
  insertionFeeUsd       Decimal   @default(0) @map("insertion_fee_usd") @db.Decimal(12, 2)
  minimumSalePriceUsd   Decimal?  @map("minimum_sale_price_usd") @db.Decimal(12, 2)
  roundingIncrementUsd  Decimal   @map("rounding_increment_usd") @db.Decimal(12, 2)
  allocationMethod      String    @map("allocation_method")
  createdById           String    @map("created_by_id")
  approvedById          String?   @map("approved_by_id")
  approvedAt            DateTime? @map("approved_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  createdBy  User                @relation("PricingReviewCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?               @relation("PricingReviewApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  items      PricingReviewItem[]

  @@index([status, createdAt])
  @@map("pricing_reviews")
}

model PricingReviewItem {
