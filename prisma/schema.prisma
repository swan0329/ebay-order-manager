model PricingReviewItem {
  id                     String    @id @default(cuid())
  reviewId               String    @map("review_id")
  productId              String    @map("product_id")
  pocaPriceKrw           Decimal   @map("poca_price_krw") @db.Decimal(12, 2)
  totalCostKrw           Decimal   @map("total_cost_krw") @db.Decimal(12, 2)
