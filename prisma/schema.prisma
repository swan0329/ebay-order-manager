generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  WORKER
}

enum EbayEnvironment {
  SANDBOX
  PRODUCTION
}

enum SyncStatus {
  SUCCESS
  FAILED
  PARTIAL
}

enum ShipmentStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id        String   @id @default(cuid())
  loginId   String   @unique @map("login_id")
  name      String?
  role      UserRole @default(ADMIN)
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ebayAccounts                EbayAccount[]
  orders                      Order[]
  listingTemplates            ListingTemplate[]
  listingDrafts               ListingDraft[]
  ebayPolicyCaches            EbayPolicyCache[]
  ebayInventoryLocationCaches EbayInventoryLocationCache[]
  productMappings             ProductMapping[]
  productUploadJobs           ProductUploadJob[]
  syncLogs                    SyncLog[]
  pricingSettingsUpdated      PricingSettings[]            @relation("PricingSettingsUpdatedBy")
  pricingReviewsCreated       PricingReview[]              @relation("PricingReviewCreatedBy")
  pricingReviewsApproved      PricingReview[]              @relation("PricingReviewApprovedBy")
  pricingReviewItemsApplied   PricingReviewItem[]          @relation("PricingReviewItemAppliedBy")
  pocamarketSyncBatches       PocamarketSyncBatch[]
  pocamarketSyncItemsApplied  PocamarketSyncItem[]         @relation("PocamarketSyncItemAppliedBy")
  pocamarketSyncSettings      PocamarketSyncSettings?
  ebayReportImports           EbayReportImport[]
  ebayActiveReportSyncs       EbayActiveReportSync[]
  automationRulesUpdated      AutomationRule[]             @relation("AutomationRuleUpdatedBy")

  @@map("users")
}

model EbayAccount {
  id                    String          @id @default(cuid())
  userId                String          @map("user_id")
  ebayUserId            String?         @map("ebay_user_id")
  username              String?
  environment           EbayEnvironment @default(SANDBOX)
  scopes                String
  accessTokenEncrypted  String          @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String          @map("refresh_token_encrypted") @db.Text
  expiresAt             DateTime        @map("expires_at")
  refreshTokenExpiresAt DateTime?       @map("refresh_token_expires_at")
  rawProfile            Json?           @map("raw_profile")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([userId, environment, ebayUserId])
  @@map("ebay_accounts")
}

model Order {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  ebayAccountId       String?   @map("ebay_account_id")
  // 판매 채널. 지금은 EBAY와 SHOPIFY만 쓰지만 몰이 늘어도 열을 더하지 않는다.
  channel             String    @default("EBAY")
  // 채널이 준 주문번호. 채널 공통으로 주문을 가리키는 값이다.
  externalOrderId     String    @map("external_order_id")
  // eBay 전용 주문번호. 채널 공통 자리로 옮겼지만 기존 동기화가 그대로 쓰므로 남긴다.
  ebayOrderId         String?   @map("ebay_order_id")
  orderStatus         String    @map("order_status")
  fulfillmentStatus   String    @map("fulfillment_status")
  buyerName           String?   @map("buyer_name")
  buyerUsername       String?   @map("buyer_username")
  buyerCountry        String?   @map("buyer_country")
  totalAmount         Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  currency            String    @default("USD")
  orderDate           DateTime  @map("order_date")
  paidAt              DateTime? @map("paid_at")
  modifiedAt          DateTime? @map("modified_at")
  shipByDate          DateTime? @map("ship_by_date")
  tags                String[]  @default([])
  warningLevel        String    @default("none") @map("warning_level")
  warningMessage      String?   @map("warning_message") @db.Text
  automationCheckedAt DateTime? @map("automation_checked_at")
  // 주문 목록에서 관리자가 확인을 눌렀는지. 주문 동기화 자체가 확인 처리로 바뀌면 안 된다.
  acknowledgedAt     DateTime? @map("acknowledged_at")
  rawJson             Json      @map("raw_json")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayAccount        EbayAccount?        @relation(fields: [ebayAccountId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  shipments          Shipment[]
  inventoryMovements InventoryMovement[]

  @@unique([ebayAccountId, ebayOrderId])
  @@unique([channel, ebayAccountId, externalOrderId])
  @@index([channel, orderDate])
  @@index([userId, fulfillmentStatus])
  @@index([userId, fulfillmentStatus, orderDate])
  @@index([userId, orderDate])
  @@index([warningLevel])
  @@index([orderDate])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String   @map("order_id")
  productId     String?  @map("product_id")
  lineItemId    String   @map("line_item_id")
  title         String
  sku           String?
  quantity      Int      @default(1)
  stockDeducted Boolean  @default(false) @map("stock_deducted")
  matchedBy     String?  @map("matched_by")
  matchScore    Float?   @map("match_score")
  rawJson       Json?    @map("raw_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([orderId, lineItemId])
  @@index([sku])
  @@index([productId])
  @@index([stockDeducted])
  @@map("order_items")
}

model Product {
  id                       String    @id @default(cuid())
  sku                      String    @unique
  pocamarketId             String?   @unique @map("pocamarket_id")
  isSoldOut                Boolean   @default(false) @map("is_sold_out")
  pocamarketAvailableCount Int?      @map("pocamarket_available_count")
  pocamarketSyncedAt       DateTime? @map("pocamarket_synced_at")
  pocamarketLastAttemptAt  DateTime? @map("pocamarket_last_attempt_at")
  internalCode             String?   @map("internal_code")
  productName              String    @map("product_name")
  optionName               String?   @map("option_name")
  category                 String?
  brand                    String?
  costPrice                Decimal?  @map("cost_price") @db.Decimal(12, 2)
  salePrice                Decimal?  @map("sale_price") @db.Decimal(12, 2)
  stockQuantity            Int       @default(0) @map("stock_quantity")
  safetyStock              Int       @default(0) @map("safety_stock")
  location                 String?
  memo                     String?   @db.Text
  imageUrl                 String?   @map("image_url")
  status                   String    @default("active")
  ebayTitle                String?   @map("ebay_title")
  descriptionHtml          String?   @map("description_html") @db.Text
  ebayPrice                Decimal?  @map("ebay_price") @db.Decimal(12, 2)
  ebayImageUrls            String[]  @default([]) @map("ebay_image_urls")
  ebayCategoryId           String?   @map("ebay_category_id")
  ebayCondition            String?   @map("ebay_condition")
  ebayShippingProfile      String?   @map("ebay_shipping_profile")
  ebayReturnProfile        String?   @map("ebay_return_profile")
  ebayPaymentProfile       String?   @map("ebay_payment_profile")
  ebayMerchantLocationKey  String?   @map("ebay_merchant_location_key")
  ebayMarketplaceId        String?   @map("ebay_marketplace_id")
  ebayCurrency             String?   @map("ebay_currency")
  ebayOfferId              String?   @map("ebay_offer_id")
  ebayItemId               String?   @map("ebay_item_id")
  listingStatus            String?   @map("listing_status")
  lastUploadedAt           DateTime? @map("last_uploaded_at")
  uploadError              String?   @map("upload_error") @db.Text
  uploadErrorSummary       String?   @map("upload_error_summary") @db.Text
  uploadRawError           Json?     @map("upload_raw_error")
  shopifyProductId         String?   @map("shopify_product_id")
  shopifyVariantId         String?   @map("shopify_variant_id")
  shopifyInventoryItemId   String?   @map("shopify_inventory_item_id")
  shopifyStatus            String?   @map("shopify_status")
  shopifyLastUploadedAt    DateTime? @map("shopify_last_uploaded_at")
  shopifyUploadError       String?   @map("shopify_upload_error") @db.Text
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  orderItems          OrderItem[]
  movements           InventoryMovement[]
  mappings            ProductMapping[]
  uploadJobs          ProductUploadJob[]
  listingDrafts       ListingDraft[]
  listingLinks        InventoryListingLink[]
  productListings     ProductListing[]
  automationEvents    AutomationEvent[]
  pricingReviewItems  PricingReviewItem[]
  pocamarketSyncItems PocamarketSyncItem[]
  ebayActiveListings  EbayActiveListing[]

  @@index([status])
  @@index([stockQuantity])
  @@index([productName])
  @@index([listingStatus])
  @@index([ebayItemId])
  @@index([shopifyProductId])
  @@index([pocamarketLastAttemptAt])
  @@index([pocamarketSyncedAt])
  @@map("products")
}

model ProductListing {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  channel    String
  externalId String   @map("external_id")
  price      Decimal? @db.Decimal(12, 2)
  quantity   Int?
  status     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, channel])
  @@index([channel, externalId])
  @@index([channel, status])
  @@map("product_listings")
}

model AutomationRule {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(true)
  mode        String   @default("NOTIFY")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User?             @relation("AutomationRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  events    AutomationEvent[]

  @@map("automation_rules")
}

model AutomationEvent {
  id         String   @id @default(cuid())
  ruleId     String   @map("rule_id")
  productId  String?  @map("product_id")
  triggerKey String   @map("trigger_key")
  status     String
  message    String   @db.Text
  rawJson    Json?    @map("raw_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  rule    AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  product Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([ruleId, triggerKey])
  @@index([status, createdAt])
  @@index([productId, createdAt])
  @@map("automation_events")
}

model EbayReportImport {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  fileName         String   @map("file_name")
  completeSnapshot Boolean  @default(false) @map("complete_snapshot")
  rowCount         Int      @default(0) @map("row_count")
  matchedCount     Int      @default(0) @map("matched_count")
  unmatchedCount   Int      @default(0) @map("unmatched_count")
  duplicateCount   Int      @default(0) @map("duplicate_count")
  endedCount       Int      @default(0) @map("ended_count")
  createdAt        DateTime @default(now()) @map("created_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  listings EbayActiveListing[]

  @@index([userId, createdAt])
  @@map("ebay_report_imports")
}

// Feed API는 비동기로 보고서를 만든다. 외부 task ID를 보존해야 재시도 때
// 같은 보고서를 중복 요청하지 않고, 완료 파일만 전체 스냅샷으로 반영할 수 있다.
model EbayActiveReportSync {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  ebayTaskId     String   @unique @map("ebay_task_id")
  status         String   @default("QUEUED")
  errorMessage   String?  @map("error_message") @db.Text
  reportImportId String?  @map("report_import_id")
  requestedAt    DateTime @default(now()) @map("requested_at")
  completedAt    DateTime? @map("completed_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, requestedAt])
  @@map("ebay_active_report_syncs")
}

model EbayActiveListing {
  id          String    @id @default(cuid())
  importId    String    @map("import_id")
  productId   String?   @map("product_id")
  itemId      String    @map("item_id")
  sku         String?
  title       String?
  // eBay에서 한 번 받아와 저장해 두는 대표 이미지. 연결 화면에서 카드를 눈으로
  // 대조하는 데 쓰며, 같은 리스팅을 다시 열어도 eBay를 다시 부르지 않는다.
  imageUrl    String?   @map("image_url")
  price       Decimal?  @db.Decimal(12, 2)
  quantity    Int?
  currency    String?
  status      String    @default("ACTIVE")
  matchStatus String    @default("UNMATCHED") @map("match_status")
  // 사람이 이 리스팅을 상품에 연결한 시각. 방금 한 연결을 되짚어 풀 수 있게 남긴다.
  linkedAt    DateTime? @map("linked_at")
  rawJson     Json?     @map("raw_json")
  createdAt   DateTime  @default(now()) @map("created_at")

  reportImport EbayReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  product      Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([importId, itemId])
  @@index([productId, createdAt])
  @@index([sku])
  @@index([matchStatus])
  @@map("ebay_active_listings")
}

model VariationListingState {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  groupKey             String    @map("group_key")
  parentSku            String    @map("parent_sku")
  title                String
  ebayItemId           String?   @map("ebay_item_id")
  includedProductIds   Json      @default("[]") @map("included_product_ids")
  pendingProductIds    Json      @default("[]") @map("pending_product_ids")
  thumbnailStatus      String    @default("MISSING") @map("thumbnail_status")
  thumbnailUrl         String?   @map("thumbnail_url")
  thumbnailKey         String?   @map("thumbnail_key")
  thumbnailHash        String?   @map("thumbnail_hash")
  thumbnailProductIds  Json      @default("[]") @map("thumbnail_product_ids")
  thumbnailError       String?   @map("thumbnail_error") @db.Text
  thumbnailGeneratedAt DateTime? @map("thumbnail_generated_at")
  lastExportedAt       DateTime? @map("last_exported_at")
  lastConfirmedAt      DateTime? @map("last_confirmed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([userId, groupKey])
  @@unique([userId, parentSku])
  @@index([userId, ebayItemId])
  @@map("variation_listing_states")
}

model VariationThumbnailSetting {
  userId                 String   @id @map("user_id")
  logoUrl                String?  @map("logo_url")
  logoKey                String?  @map("logo_key")
  watermarkText          String?  @map("watermark_text")
  watermarkOpacity       Float    @default(0.06) @map("watermark_opacity")
  watermarkLogoSize      Int      @default(50) @map("watermark_logo_size")
  watermarkGap           Int      @default(25) @map("watermark_gap")
  applyToIndividualCards Boolean  @default(true) @map("apply_to_individual_cards")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("variation_thumbnail_settings")
}

// PC에서 도는 포카마켓 브리지가 마지막으로 서버에 붙은 시각. 주문 화면에서
// "휴대폰 연결 대기"가 정상 대기인지 브리지가 꺼진 것인지 구분하는 데 쓴다.
model PocamarketBridgeHeartbeat {
  deviceSerial String   @id @map("device_serial")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([lastSeenAt(sort: Desc)])
  @@map("pocamarket_bridge_heartbeats")
}

model ProductUploadJob {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  productId        String?   @map("product_id")
  templateId       String?   @map("template_id")
  sku              String
  source           String    @default("single")
  action           String?
  status           String    @default("pending")
  message          String?   @db.Text
  error            String?   @db.Text
  errorSummary     String?   @map("error_summary") @db.Text
  rawEbayError     Json?     @map("raw_ebay_error")
  rawJson          Json?     @map("raw_json")
  finalPayloadJson Json?     @map("final_payload_json")
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  template ListingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([productId])
  @@index([templateId])
  @@index([sku])
  @@map("product_upload_jobs")
}

model ListingTemplate {
  id                        String   @id @default(cuid())
  userId                    String   @map("user_id")
  name                      String
  description               String?  @db.Text
  marketplaceId             String?  @map("marketplace_id")
  categoryId                String?  @map("category_id")
  condition                 String?
  conditionDescription      String?  @map("condition_description") @db.Text
  listingDuration           String?  @map("listing_duration")
  listingFormat             String?  @map("listing_format")
  currency                  String?
  defaultQuantity           Int?     @map("default_quantity")
  defaultPrice              Decimal? @map("default_price") @db.Decimal(12, 2)
  paymentPolicyId           String?  @map("payment_policy_id")
  fulfillmentPolicyId       String?  @map("fulfillment_policy_id")
  returnPolicyId            String?  @map("return_policy_id")
  merchantLocationKey       String?  @map("merchant_location_key")
  bestOfferEnabled          Boolean  @default(false) @map("best_offer_enabled")
  minimumOfferPrice         Decimal? @map("minimum_offer_price") @db.Decimal(12, 2)
  autoAcceptPrice           Decimal? @map("auto_accept_price") @db.Decimal(12, 2)
  privateListing            Boolean  @default(false) @map("private_listing")
  immediatePayRequired      Boolean  @default(false) @map("immediate_pay_required")
  descriptionTemplateHtml   String?  @map("description_template_html") @db.Text
  itemSpecificsTemplateJson Json?    @map("item_specifics_template_json")
  imageSettingsJson         Json?    @map("image_settings_json")
  shippingSettingsJson      Json?    @map("shipping_settings_json")
  skuSettingsJson           Json?    @map("sku_settings_json")
  titleTemplate             String?  @map("title_template")
  excludedLocationsJson     Json?    @map("excluded_locations_json")
  promotedListingEnabled    Boolean  @default(false) @map("promoted_listing_enabled")
  promotedCampaignId        String?  @map("promoted_campaign_id")
  promotedAdRate            Decimal? @map("promoted_ad_rate") @db.Decimal(5, 2)
  promotedFundingModel      String?  @map("promoted_funding_model")
  isDefault                 Boolean  @default(false) @map("is_default")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadJobs    ProductUploadJob[]
  listingDrafts ListingDraft[]

  @@index([userId, isDefault])
  @@index([userId, name])
  @@map("listing_templates")
}

model ProductMapping {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  productId       String   @map("product_id")
  ebayItemId      String?  @map("ebay_item_id")
  ebayVariationId String?  @map("ebay_variation_id")
  normalizedTitle String?  @map("normalized_title") @db.Text
  source          String   @default("manual")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, ebayItemId, ebayVariationId])
  @@index([userId, ebayItemId])
  @@index([userId, normalizedTitle])
  @@index([productId])
  @@map("product_mappings")
}

model ListingDraft {
  id                     String    @id @default(cuid())
  userId                 String    @map("user_id")
  sourceInventoryId      String?   @map("source_inventory_id")
  templateId             String?   @map("template_id")
  sku                    String
  title                  String
  subtitle               String?
  descriptionHtml        String?   @map("description_html") @db.Text
  price                  Decimal?  @db.Decimal(12, 2)
  quantity               Int?
  imageUrlsJson          Json?     @map("image_urls_json")
  categoryId             String?   @map("category_id")
  condition              String?
  conditionDescription   String?   @map("condition_description") @db.Text
  itemSpecificsJson      Json?     @map("item_specifics_json")
  marketplaceId          String?   @map("marketplace_id")
  currency               String?
  paymentPolicyId        String?   @map("payment_policy_id")
  fulfillmentPolicyId    String?   @map("fulfillment_policy_id")
  returnPolicyId         String?   @map("return_policy_id")
  merchantLocationKey    String?   @map("merchant_location_key")
  bestOfferEnabled       Boolean   @default(false) @map("best_offer_enabled")
  minimumOfferPrice      Decimal?  @map("minimum_offer_price") @db.Decimal(12, 2)
  autoAcceptPrice        Decimal?  @map("auto_accept_price") @db.Decimal(12, 2)
  privateListing         Boolean   @default(false) @map("private_listing")
  immediatePayRequired   Boolean   @default(false) @map("immediate_pay_required")
  listingFormat          String?   @map("listing_format")
  status                 String    @default("draft")
  ebayItemId             String?   @map("ebay_item_id")
  offerId                String?   @map("offer_id")
  listingStatus          String?   @map("listing_status")
  errorSummary           String?   @map("error_summary") @db.Text
  rawErrorJson           Json?     @map("raw_error_json")
  validationJson         Json?     @map("validation_json")
  fieldSourceJson        Json?     @map("field_source_json")
  promotedListingEnabled Boolean   @default(false) @map("promoted_listing_enabled")
  promotedCampaignId     String?   @map("promoted_campaign_id")
  promotedAdRate         Decimal?  @map("promoted_ad_rate") @db.Decimal(5, 2)
  promotedStatus         String?   @map("promoted_status")
  promotedErrorSummary   String?   @map("promoted_error_summary") @db.Text
  lastUploadedAt         DateTime? @map("last_uploaded_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceInventory    Product?            @relation(fields: [sourceInventoryId], references: [id], onDelete: SetNull)
  template           ListingTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  pricingReviewItems PricingReviewItem[]

  @@index([userId, status, updatedAt])
  @@index([sourceInventoryId])
  @@index([templateId])
  @@index([sku])
  @@map("listing_drafts")
}

model PricingSettings {
  id                    String   @id @default("default")
  domesticShippingKrw   Decimal  @default(0) @map("domestic_shipping_krw") @db.Decimal(12, 2)
  buyingAgencyFeeKrw    Decimal  @default(0) @map("buying_agency_fee_krw") @db.Decimal(12, 2)
  exchangeRateKrwPerUsd Decimal  @map("exchange_rate_krw_per_usd") @db.Decimal(12, 4)
  targetMarginRate      Decimal  @map("target_margin_rate") @db.Decimal(9, 6)
  ebayFeeRate           Decimal  @map("ebay_fee_rate") @db.Decimal(9, 6)
  advertisingRate       Decimal  @map("advertising_rate") @db.Decimal(9, 6)
  minimumSalePriceUsd   Decimal? @map("minimum_sale_price_usd") @db.Decimal(12, 2)
  roundingIncrementUsd  Decimal  @default(0.10) @map("rounding_increment_usd") @db.Decimal(12, 2)
  allocationMethod      String   @default("PER_CARD_FIXED") @map("allocation_method")
  updatedById           String   @map("updated_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
