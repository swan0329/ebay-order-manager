model PocamarketSyncBatch {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  status       String    @default("QUEUED")
  totalCount   Int       @default(0) @map("total_count")
  scannedCount Int       @default(0) @map("scanned_count")
  errorMessage String?   @map("error_message") @db.Text
  deviceSerial String?   @map("device_serial")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PocamarketSyncItem[]

  @@index([userId, status, createdAt])
  @@map("pocamarket_sync_batches")
}

model PocamarketSyncSettings {
  userId            String   @id @map("user_id")
  enabled           Boolean  @default(true)
  scheduledHour     Int      @default(3) @map("scheduled_hour")
  scheduledMinute   Int      @default(0) @map("scheduled_minute")
  dailyBatchSize    Int      @default(1000) @map("daily_batch_size")
  speedProfile      String   @default("BALANCED") @map("speed_profile")
  priorityStrategy  String   @default("SMART") @map("priority_strategy")
  lastScheduledDate String?  @map("last_scheduled_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pocamarket_sync_settings")
}

model PocamarketSyncItem {
  id                     String    @id @default(cuid())
  batchId                String    @map("batch_id")
  productId              String    @map("product_id")
  productNumber          String    @map("product_number")
  previousPrice          Decimal?  @map("previous_price") @db.Decimal(12, 2)
  previousAvailableCount Int?      @map("previous_available_count")
  previousIsSoldOut      Boolean?  @map("previous_is_sold_out")
  observedPrice          Decimal?  @map("observed_price") @db.Decimal(12, 2)
  observedAvailableCount Int?      @map("observed_available_count")
  availability           String?
  status                 String    @default("QUEUED")
  errorMessage           String?   @map("error_message") @db.Text
  errorCode              String?   @map("error_code")
  retryCount             Int       @default(0) @map("retry_count")
  responseAdapter        String?   @map("response_adapter")
  deviceSerial           String?   @map("device_serial")
  observedAt             DateTime? @map("observed_at")
  appliedById            String?   @map("applied_by_id")
  appliedAt              DateTime? @map("applied_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  batch     PocamarketSyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  appliedBy User?               @relation("PocamarketSyncItemAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)

  @@unique([batchId, productId])
  @@index([batchId, status])
  @@index([productId, createdAt])
  @@index([errorCode, createdAt])
  @@map("pocamarket_sync_items")
}

model PricingReview {
