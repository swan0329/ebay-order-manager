DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ebay_order_manager?schema=public"

# Generate strong values:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-32-byte-random-base64-or-long-secret"
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-random-base64"

ADMIN_LOGIN_ID="admin"
ADMIN_PASSWORD="change-me-before-production"

# eBay developer keys
EBAY_ENV="sandbox"
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_RU_NAME=""
# 메시지 조회를 쓰려면 commerce.message 권한까지 eBay 재연결 화면에서 승인해야 합니다.
EBAY_SCOPES="https://api.ebay.com/oauth/api_scope/sell.fulfillment https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.account.readonly https://api.ebay.com/oauth/api_scope/sell.marketing https://api.ebay.com/oauth/api_scope/sell.marketing.readonly https://api.ebay.com/oauth/api_scope/sell.finances https://api.ebay.com/oauth/api_scope/commerce.identity.readonly https://api.ebay.com/oauth/api_scope/commerce.message"

# eBay Marketplace Account Deletion endpoint
# Generate an allowed 32-80 character token:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EBAY_DELETION_VERIFICATION_TOKEN=""
# Optional. Set this to the exact URL registered in eBay Developer Console.
EBAY_DELETION_ENDPOINT_URL=""

# Cloudflare R2 (photo-card-match)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# Dewatermark.ai image watermark removal API
# Create a key at https://dewatermark.ai/ko/api-management
DEWATERMARK_API_KEY=""
# STANDARD uses the v3 endpoint (1 credit); PRO uses the higher-quality endpoint (3 credits).
DEWATERMARK_API_MODE="STANDARD"

# PocaMarket domestic card sell API (public product data; no login token required)
POCAMARKET_PRODUCT_URL_TEMPLATE="https://phocamarket.com/card/v2/{pocamarket_id}/sell"
# Optional ordered fallback endpoints. The collector tries the next URL on 404
# or a response-schema mismatch.
POCAMARKET_PRODUCT_URL_TEMPLATES_JSON='["https://phocamarket.com/card/v2/{pocamarket_id}/sell"]'
POCAMARKET_API_HEADERS_JSON='{}'
POCAMARKET_RESPONSE_MODE="CARD_SELL_LIST"
POCAMARKET_MIN_DELAY_MS="1000"
POCAMARKET_MAX_DELAY_MS="3000"
POCAMARKET_MAX_RETRIES="0"
POCAMARKET_BASE_BACKOFF_MS="2000"
POCAMARKET_REQUEST_TIMEOUT_MS="3000"
